<?xml version="1.0"?>
<package format="3">
  <name>omnifleet_t2_mola_experiments</name>
  <version>0.1.0</version>
  <description>Isolated no-wheel MOLA Simple and Smoother experiments for OmniFleet T2.</description>
  <maintainer email="iecme@example.com">iecme</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
