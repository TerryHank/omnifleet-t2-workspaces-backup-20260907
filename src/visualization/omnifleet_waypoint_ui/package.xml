<?xml version="1.0"?>
<package format="3">
  <name>omnifleet_waypoint_ui</name>
  <version>0.2.0</version>
  <description>Semantic Foxglove waypoint UI bridge for one OmniFleet robot.</description>
  <maintainer email="terryhank@example.com">TerryHank</maintainer>
  <license>MIT</license>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
