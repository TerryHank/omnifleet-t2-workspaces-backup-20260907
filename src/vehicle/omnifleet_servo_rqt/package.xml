<?xml version="1.0"?>
<package format="3">
  <name>omnifleet_servo_rqt</name>
  <version>0.1.0</version>
  <description>RQT panel for FTServo SMS/STS/HTS setup and motion.</description>
  <maintainer email="iecme@example.com">iecme</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>omnifleet_interfaces</exec_depend>
  <export>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
    <build_type>ament_python</build_type>
  </export>
</package>
