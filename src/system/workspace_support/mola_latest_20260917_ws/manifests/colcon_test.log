7:     icp_quality_controller_setpoint: 0.85
7:     initial_sigma: 0.50  # [m]
7:     kp: 2.0
7:     max_sigma_step: 0.05  # [m]
7:     maximum_sigma: 2.00  # [m]
7:     min_motion: 0.5  # [m]
7:     recover_after_n_bad: 2
7:     recover_growth_factor: 2.0
7:     # Sustained-failure recovery: if enabled, sigma is grown multiplicatively
7:     # after a streak of bad ICPs, capped at maximum_sigma, so the matcher
7:     # window can re-open and ICP can recover. Enabled by default: without it,
7:     # once sigma is driven down near min_motion by a run of easy/near-static
7:     # scans (e.g. goodness consistently above icp_quality_controller_setpoint),
7:     # a single larger inter-scan motion (a turn, a bump, or just ordinary
7:     # scan-to-scan variability once sigma is already pinned at its floor) can
7:     # push ICP into failure, and with sigma frozen the correspondence search
7:     # window never reopens, so the pipeline stalls indefinitely
7:     # (estimated_trajectory never grows again). Set to false to restore the
7:     # old behavior. `maximum_sigma` must be set strictly above
7:     # `initial_sigma`, or this mechanism is a no-op: sigma always starts
7:     # each run AT initial_sigma, so a bad ICP on frame 1 (e.g. a slightly
7:     # imprecise localization-only seed pose against a prebuilt map) has no
7:     # room to grow into and can never recover (observed in testing as ICP
7:     # goodness stuck just under min_icp_goodness for an entire run).
7:     # 
7:     # recover_after_n_bad/recover_growth_factor default to a fast reaction
7:     # (2 bad frames, x2.0 growth) rather than a slow one (5 bad frames,
7:     # x1.5): every frame spent stuck is a frame of real, untracked vehicle
7:     # motion accumulating; the slower defaults let that gap grow to the
7:     # point where, once the search window finally reopens, ICP can lock onto
7:     # a self-consistent but WRONG registration (observed in testing as a
7:     # sudden ~30-40 deg yaw error that then persisted for the rest of a run)
7:     # instead of recovering the true pose.
7:     recover_on_sustained_failure: true
7:   # Generate CSV with the evolution of internal variables:
7:   debug_traces:
7:     output_file: mola-lo-traces.csv
7:     save_to_file: false
7:   # REP-107 diagnostics thresholds published on /diagnostics via mola_bridge_ros2.
7:   # Any of these can be omitted to keep its built-in default.
7:   diagnostics:
7:     dropped_ratio_error: 0.50  # [0-1] ERROR if dropped-frames ratio exceeds
7:     dropped_ratio_warn: 0.20  # [0-1] WARN if dropped-frames ratio exceeds
7:     icp_quality_error: 0.10  # [0-1] ERROR if icp_quality below this
7:     icp_quality_warn: 0.30  # [0-1] WARN if icp_quality below this
7:     input_error_sec: 5.0  # [s]   ERROR if no observation for this long
7:     input_stale_sec: 3.0  # [s]   STALE if no observation for this long
7:     timing_utilization_warn: 0.80  # [0-1] WARN if avg process time / sensor period exceeds
7:   # Save the final trajectory in TUM format. Disabled by default.
7:   estimated_trajectory:
7:     output_file: estimated_trajectory.tum
7:     save_to_file: false
7:   # These sensor labels will be handled as GNSS (GPS) (For storage in simplemap only)
7:   gnss_sensor_label: gps
7:   # Profile the internal steps of the ICP implementation:
7:   icp_profiler_enabled: false
7:   # IMU accelerometer-based verticality correction:
7:   # Uses averaged accelerometer readings to constrain ICP pitch/roll.
7:   imu_gravity_correction:
7:     adaptive_sigma: true
7:     averaging_samples: 20
7:     enabled: true
7:     # NOTE: averaging_samples must fit inside max_age_seconds at the actual IMU
7:     # rate, or estimatedPitchRoll() returns nothing and the constraint is
7:     # silently inactive (at 400 Hz, 2.0 s holds only ~800 samples).
7:     # 
7:     # Estimate the map-frame vertical online instead of freezing it from one
7:     # accelerometer average at the first keyframe. See
7:     # mola::imu::MapGravityEstimator: it solves for gravity in the map frame
7:     # (plus IMU biases) from preintegrated IMU and this odometry's own relative
7:     # attitudes/velocities, so platform acceleration cancels and no
7:     # quasi-static window is required.
7:     map_gravity:
7:       enabled: false
7:       # Compute and log the estimate without letting it affect the verticality
7:       # reference, so it can be scored against ground truth on a new dataset
7:       # without its own feedback contaminating the map frame it is estimating.
7:       log_only: false
7:       min_interval_seconds: 1.0
7:       # NOTE: there is deliberately no ACCURACY threshold here. The estimator
7:       # reports every usable estimate with its earned pitch/roll sigma, which is
7:       # added in quadrature to the gravity prior's sigma.
7:       # 
7:       # CAUTION: "a weak estimate silences itself" is NOT established. A later
7:       # measurement on a handheld dataset put the error/sigma ratio at 8.4
7:       # median and 19.0 worst case, i.e. the reported sigma is roughly an order
7:       # of magnitude tighter than the estimate is accurate, and no better
7:       # calibrated after the interval gate below than before it. Do not use
7:       # those sigmas as a confidence gate until that is understood; the
7:       # re-level trigger above deliberately does not.
7:       # 
7:       # There IS a data-quantity precondition, which is a different thing. Until
7:       # the window holds enough intervals the solution is pulled by the |g|
7:       # constraint and the bias priors, and that pull is a BIAS the linearized
7:       # covariance cannot see, so the estimate is not merely uncertain, it is
7:       # confidently wrong. Until then the accelerometer capture is the better
7:       # reference, and this keeps LO on it. This gates the PER-SCAN PRIOR only:
7:       # the one-off map-frame re-level above has the opposite need (its estimate
7:       # is best at the first solve) and uses its own, much shorter, gate.
7:       min_intervals_for_convergence: 130
7:       # Rotate the MAP FRAME itself, once, so it becomes gravity-aligned,
7:       # instead of only feeding the per-scan verticality prior. The map frame is
7:       # the initial body frame, so a platform that starts tilted produces a map
7:       # that leans by that tilt forever: measured on a handheld dataset, a
7:       # median of 8.7 deg (max 20.7). This is a gauge change - local map,
7:       # simplemap, trajectory, state estimator and the published `odom` frame
7:       # all rotate together about the map origin - so no relative quantity
7:       # moves. OFF by default: it changes the frame every product of the run is
7:       # expressed in.
7:       relevel_map_frame: false
7:       # Readiness for the re-level, as an interval count. Note this is NOT
7:       # min_intervals_for_convergence below: that one gates the per-scan prior,
7:       # where the later, more settled estimate is what matters. For leveling the
7:       # map once, the estimate is at its BEST at the first solve (measured 0.72
7:       # deg at ~5.6 s) and slowly degrades from there, so waiting costs accuracy.
7:       # 5 intervals is the first solve under solve_every_n above.
7:       relevel_min_intervals: 5
7:       # Magnitude gate: only re-level when there is enough tilt that removing it
7:       # beats the error of the estimate doing the removing. Measured at the
7:       # firing point on a handheld dataset, that error is 0.63 deg median,
7:       # 1.43 deg p90, 1.75 deg worst. Note the gate tests the ESTIMATE while the
7:       # quantity that must be large is the TRUE tilt, and the two differ by
7:       # exactly that error, so the threshold is ~2x the p90 rather than 1x:
7:       # gating at 2 deg let one near-level sequence through (estimate 2.8 deg
7:       # against a true 1.1 deg) and made it 0.7 deg worse. Below the threshold
7:       # the re-level stands down permanently (and says so in the log) instead of
7:       # retrying, which is what keeps an already-level dataset untouched.
7:       relevel_min_tilt_deg: 3.0
7:       solve_every_n: 5
7:       # Sliding-window length. The whole point is that verticality information
7:       # ACCUMULATES, so this wants to be much longer than the estimator default.
7:       window_size: 200
7:     map_origin_capture_timeout: 3.0
7:     # The one-shot map-origin verticality capture defines the map's vertical
7:     # for the whole run, so it is deferred to a later scan while the buffered
7:     # accelerometer directions disagree by more than this (i.e. the reading is
7:     # motion, not gravity), and taken as-is after the timeout.
7:     map_origin_max_dispersion_deg: 1.0
7:     max_age_seconds: 2.0
7:     sigma_deg: 2.0
7:     # Yaw-free, rank-2 verticality constraint solved by mp2p_icp. Set to false
7:     # only to reproduce results from the legacy path, which folded tilt into
7:     # the SE(3) pose prior.
7:     use_rank2_prior: true
7:   # These sensor labels will be handled as IMU observations:
7:   imu_sensor_label: imu
7:   # These sensor labels will be handled as LIDAR observations:
7:   # Can be overridden with cli flag --lidar-sensor-label
7:   lidar_sensor_labels:
7:     - lidar
7:     - /ouster/points
7:   # How often to update the local map model:
7:   local_map_updates:
7:     check_for_removal_every_n: 100
7:     enabled: true
7:     load_existing_local_map: ''
7:     load_map_after_gui_init: false
7:     # Should match the "remove farther than" option of the local metric map. "0" means deletion of distant key-frames is disabled
7:     max_distance_to_keep_keyframes: max(100.0, 1.50*ESTIMATED_OBSERVATION_RADIUS)  # [m]
7:     min_nearby_poses_occupied: 1
7:     min_rotation_between_keyframes: (15 + sqrt(wx^2+wy^2+wz^2)*5 )  # [deg]
7:     # Idea: don't integrate scans with a high rotational speed since they are probably not correctly deskewed:
7:     min_translation_between_keyframes: (0.1e-2 + sqrt(wx^2+wy^2+wz^2)*0.1)*ESTIMATED_OBSERVATION_RADIUS  # [m]
7:     publish_map_updates_every_n: 40
7:     save_final_local_map: ''  # If not empty, saves the final local metric map to a ".mm" file
7:   # Minimum ICP quality to insert it into the map:
7:   min_icp_goodness: 0.50
7:   # [m^-2] Minimum motion model covariance (in X,Y,Z) to consider a state estimation as valid as prior for ICP.
7:   min_motion_model_xyz_cov_inv: 1.0
7:   # Optionally, drop lidar data too close in time:
7:   min_time_between_scans: 1e-3  # [seconds]
7:   multiple_lidars:
7:     lidar_count: 1  # useful only if using several lidar_sensor_labels or regex's.
7:     max_time_offset: 0.1  # [s]
7:   # Parameters for max sensor range automatic estimation:
7:   observation_radius_filter_coefficient: 0.95
7:   # Quantile of the per-point norms taken as ESTIMATED_OBSERVATION_RADIUS.
7:   # 1.0 = the bounding-box max-norm, i.e. one far return sets the scene
7:   # scale for the six parameters derived from it. Default unchanged;
7:   # exposed so the robust alternative can be measured.
7:   observation_radius_quantile: 1.0
7:   # Optional filters to discard incomplete 3D scans from
7:   # faulty network, missing UDP packets, etc.
7:   observation_validity_checks:
7:     check_layer_name: raw
7:     enabled: false
7:     minimum_point_count: 1000
7:   # If enabled, vehicle twist will be optimized during ICP
7:   # enabling better and more robust odometry in high dynamics motion without an IMU.
7:   # NOTE: Disabled for more efficient deskew in the GICP pipeline with IMU.
7:   # Enabling it costs about 25% more time per scan. On KITTI, which has no IMU
7:   # and so no other source of velocity, it still bought nothing measurable, so
7:   # do not assume it helps just because a platform lacks an IMU: measure it.
7:   optimize_twist: false
7:   pipeline_name: GICP (Generalized ICP) with cov-to-cov pairings  # For display/debug only
7:   # Profile the main steps of the odometry pipeline:
7:   pipeline_profiler_enabled: false
7:   # If enabled, deskewed scans will be published (so, they will be available as ROS2 messages), mostly for visualization.
7:   # This may slow-down the system, so it is disabled by default.
7:   publish_deskewed_scans: false
7:   # When publishing pose updates, the reference frame for both, estimated robot poses, and the local map.
7:   publish_reference_frame: odom
7:   # When publishing pose updates, the vehicle frame name.
7:   publish_vehicle_frame: base_link
7:   # If enabled, a map will be stored in RAM and (if using the CLI) stored
7:   # to a ".simplemap" file for later use for localization, etc.
7:   simplemap:
7:     add_non_keyframes_too: false  # If enabled, all frames are stored in the simplemap, but non-keyframes will be without associated observations.
7:     generate: false  # Can be overridden with CLI flag --output-simplemap
7:     generate_lazy_load_scan_files: false  # If enabled, a directory will be create alongside the .simplemap and pointclouds will be externally serialized there.
7:     load_existing_simple_map: ''
7:     min_nearby_poses_occupied: 1
7:     min_rotation_between_keyframes: (15 + sqrt(wx^2+wy^2+wz^2)*5 )  # [deg]
7:     # NOTE: unlike local_map_updates above, these thresholds are NOT scaled by
7:     # angular velocity: this is what feeds the SharedKeyframeMap sink (e.g.
7:     # mola_mapper), and the old w-scaled formula (rotation threshold growing
7:     # by 500 deg per rad/s) made it create close to NO keyframes while
7:     # smoothly turning, starving loop closure of the keyframes it needs.
7:     min_translation_between_keyframes: (1.0e-2 + sqrt(wx^2+wy^2+wz^2)*0.1)*ESTIMATED_OBSERVATION_RADIUS  # [m]
7:     # Revisiting an already-mapped area creates NO keyframes with the purely
7:     # spatial criterion above, which starves loop closure of the second endpoint
7:     # of the loop. Set to a positive value [s] so only keyframes newer than that
7:     # take part in the "is there one here already?" test.
7:     nearby_keyframe_time_window: 0  # [s], 0=disabled
7:     # If enabled, this will store deskewed scans into the keyframes of simplemaps.
7:     save_deskewed_scans: false
7:     save_final_map_to_file: final_map.simplemap
7:     save_gnss_max_age: 1.0  # [s] max age of GNSS observations to keep in the keyframe
7:   # If set to false, the odometry pipeline will ignore incoming observations
7:   # until active is set to true (e.g. via the GUI).
7:   start_active: true
7:   # If run within a mola-cli container, and mola_viz is present, use these options
7:   # to show live progress:
7:   visualization:
7:     background_color_gray_level: 0.3
7:     # Camera tracks the vehicle. Exposed as an env hook so an integrator (e.g.
7:     # mola_mapper, where the mapper module owns the camera) can disable it here
7:     # without editing this pipeline. Default true (standalone LIO behavior).
7:     camera_follows_vehicle: true
7:     current_observation_alpha: 0.20
7:     current_observation_color_by_field: intensity
7:     current_observation_colormap: cmHOT  # mrpt::img::TColormap
7:     current_observation_point_size: 2.0
7:     ground_grid_spacing: 5.0  # [m]
7:     last_deskewed_observations_color_by_field: intensity
7:     last_deskewed_observations_colormap: cmJET  # mrpt::img::TColormap
7:     last_deskewed_observations_point_size: 1.0
7:     local_map_point_size: 1
7:     map_update_decimation: 10
7:     model:
7:       -
7:         file: ''  # Default: none
7:         tf.pitch: 0.0  # deg
7:         tf.roll: 90.0  # deg
7:         tf.x: 0.0  # deg
7:         tf.y: 0.0  # deg
7:         tf.yaw: 0.0  # deg
7:         tf.z: 0.0  # deg
7:     observations_decay_seconds: 10.0  # For deskewed clouds above
7:     observations_initial_alpha: 0.10
7:     show_current_observation: false  # shows "live deskewed" LiDAR points
7:     # current_pose_corner_size: 1.5
7:     # sensor_poses_corner_size: 0.5  # XYZ corner for each LiDAR sensor pose; 0 to disable
7:     show_current_pose_corner: true  # Set to false to hide the current-pose XYZ corner (e.g. for a first-person camera)
7:     show_gravity_align_vector: false
7:     show_ground_grid: true
7:     show_last_deskewed_observations_decay: true  # shows "live deskewed" LiDAR points over time
7:     show_localmap: true
7:     show_tab_control: true
7:     # Enable or disable each of the three GUI panels:
7:     show_tab_status: true
7:     show_tab_view: true
7:     # Robot /tf tree (e.g. a legged robot's joints). Requires the data source
7:     # to implement mola::TransformTreeSource (rosbag1/rosbag2 inputs and the
7:     # ROS 2 bridge do). All of these can also be toggled at runtime, in the
7:     # GUI's "View" tab.
7:     show_tf_tree: false
7:     show_trajectory: true
7:     tf_tree_corner_size: 0.1  # [m]
7:     tf_tree_exclude_frames: ''  # comma-separated; drops each frame and its subtree
7:     tf_tree_link_radius: 0.02  # [m], cylinder radius for tf links
7:     tf_tree_root_frame: ''  # empty: use the data source's base_link frame
7:     tf_tree_show_links: true
7:     tf_tree_show_names: false
7:     trajectory_rgba:
7:       - 0.1
7:       - 0.1
7:       - 0.1
7:       - 1.0
7:   # If defined, ".icplog" files will be saved if ICP quality drops below the given threshold.
7:   # Useful to debug mapping issues. If empty, only the env var MP2P_ICP_GENERATE_DEBUG_FILES and the icp.params setting will define when to save logs.
7:   write_debug_icp_log_if_quality_under: ''
