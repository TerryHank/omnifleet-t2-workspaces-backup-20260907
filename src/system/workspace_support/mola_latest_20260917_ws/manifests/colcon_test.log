7:   matchers:
7:     -
7:       class: mp2p_icp::Matcher_Cov2Cov
7:       params:
7:         allowMatchAlreadyMatchedGlobalPoints: true  # faster
7:         # Both layers here must be of the very same cov-capable map class, the
7:         # one selected below by $ {MOLA_LOCALMAP_CLASS}.
7:         layerMatches:
7:           -
7:             global: localmap
