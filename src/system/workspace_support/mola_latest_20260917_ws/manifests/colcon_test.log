6:           reserve_points: 2000000
6:           rotation_distance_weight: 2.0
6:           use_view_direction_filter: true
6:         insertOpts:
6:           remove_frames_farther_than: $f{max(100.0, 1.50*ESTIMATED_OBSERVATION_RADIUS)}  # [m]
