6:   -
6:     class_name: mp2p_icp_filters::FilterByRange
6:     params:
6:       input_pointcloud_layer: raw
6:       metric_l_infinity: true
6:       output_layer_between: raw_filtered
6:       range_max: 1.2*ESTIMATED_OBSERVATION_RADIUS
6:       range_min: max(1.0, 0.03*ESTIMATED_OBSERVATION_RADIUS)
6:   -
6:     class_name: mp2p_icp_filters::FilterDeskew
6:     params:
6:       ignore_accelerometer: false
6:       input_pointcloud_layer: raw_filtered
6:       method: MotionCompensationMethod::Linear
6:       name: FilterDeskew (viz)
6:       output_layer_class: mrpt::maps::CGenericPointsMap  # Keep intensity only
6:       output_pointcloud_layer: viz
6:       silently_ignore_no_timestamps: true  # To handle more dataset types
6:       # These (vx,...,wz) are variable names that must be defined via the
6:       # mp2p_icp::Parameterizable API to update them dynamically.
6:       twist:
6:         - vx
6:         - vy
6:         - vz
6:         - wx
6:         - wy
6:         - wz
6:   -
6:     class_name: mp2p_icp_filters::FilterDeleteLayer
6:     params:
6:       pointcloud_layer_to_remove:
6:         - raw
6:         - raw_filtered
6: # final pass:
6: observations_filter_final_pass:
6:   -
6:     class_name: mp2p_icp_filters::FilterDeleteLayer
6:     params:
6:       pointcloud_layer_to_remove:
6:         - raw
6:         - deskewed
6: # ---------------------------------------------------------------------------------
6: # LIDAR observations are, first, loaded using a generator
6: # from "observations_generator".
6: # then, optionally, filtered before being registered with ICP
6: # against the local map with filter "observations_filter_1st_pass".
6: # ---------------------------------------------------------------------------------
6: observations_generator:
6:   -
6:     class_name: mp2p_icp_filters::Generator
6:     params:
6:       name: Generator (raw)
6:       process_class_names_regex: .*
6:       process_sensor_labels_regex: .*
6:       target_layer: raw
6:       throw_on_unhandled_observation_class: true
6:   -
6:     class_name: mp2p_icp_filters::Generator
6:     params:
6:       metric_map_definition:
6:         class: mola::KeyframePointCloudMap
6:         creationOpts: ~  # none required: defaults are fine for a single scan
6:         insertOpts: ~
6:         likelihoodOpts: ~  # none required
6:         plugin: libmola_metric_maps.so  # Import additional custom user-defined map classes (search in LD_LIBRARY_PATH)
6:         renderOpts: ~
6:       name: Generator (obs)
6:       process_class_names_regex: ''  # NONE: don't process observations in the generator.
6:       target_layer: observation
6:       throw_on_unhandled_observation_class: true
6: # Path to an (optional) user-customizable pipeline definition file. Default: empty = none.
6: observations_prefilter_file: ''
6: params:
6:   absolute_minimum_observation_radius: 5.0
6:   # Adaptive threshold:
6:   adaptive_threshold:
6:     alpha: 0.90
6:     enabled: true
6:     icp_quality_controller_setpoint: 0.85
6:     initial_sigma: 0.50  # [m]
6:     kp: 2.0
6:     max_sigma_step: 0.05  # [m]
6:     maximum_sigma: 2.00  # [m]
6:     min_motion: 0.5  # [m]
6:     recover_after_n_bad: 2
6:     recover_growth_factor: 2.0
6:     # Sustained-failure recovery: if enabled, sigma is grown multiplicatively
6:     # after a streak of bad ICPs, capped at maximum_sigma, so the matcher
6:     # window can re-open and ICP can recover. Enabled by default: without it,
6:     # once sigma is driven down near min_motion by a run of easy/near-static
6:     # scans (e.g. goodness consistently above icp_quality_controller_setpoint),
6:     # a single larger inter-scan motion (a turn, a bump, or just ordinary
6:     # scan-to-scan variability once sigma is already pinned at its floor) can
6:     # push ICP into failure, and with sigma frozen the correspondence search
6:     # window never reopens, so the pipeline stalls indefinitely
6:     # (estimated_trajectory never grows again). Set to false to restore the
6:     # old behavior. `maximum_sigma` must be set strictly above
6:     # `initial_sigma`, or this mechanism is a no-op: sigma always starts
6:     # each run AT initial_sigma, so a bad ICP on frame 1 (e.g. a slightly
6:     # imprecise localization-only seed pose against a prebuilt map) has no
6:     # room to grow into and can never recover (observed in testing as ICP
6:     # goodness stuck just under min_icp_goodness for an entire run).
6:     # 
6:     # recover_after_n_bad/recover_growth_factor default to a fast reaction
6:     # (2 bad frames, x2.0 growth) rather than a slow one (5 bad frames,
6:     # x1.5): every frame spent stuck is a frame of real, untracked vehicle
6:     # motion accumulating; the slower defaults let that gap grow to the
6:     # point where, once the search window finally reopens, ICP can lock onto
6:     # a self-consistent but WRONG registration (observed in testing as a
6:     # sudden ~30-40 deg yaw error that then persisted for the rest of a run)
6:     # instead of recovering the true pose.
6:     recover_on_sustained_failure: true
6:   # Generate CSV with the evolution of internal variables:
6:   debug_traces:
6:     output_file: mola-lo-traces.csv
6:     save_to_file: false
6:   # REP-107 diagnostics thresholds published on /diagnostics via mola_bridge_ros2.
6:   # Any of these can be omitted to keep its built-in default.
6:   diagnostics:
6:     dropped_ratio_error: 0.50  # [0-1] ERROR if dropped-frames ratio exceeds
6:     dropped_ratio_warn: 0.20  # [0-1] WARN if dropped-frames ratio exceeds
6:     icp_quality_error: 0.10  # [0-1] ERROR if icp_quality below this
6:     icp_quality_warn: 0.30  # [0-1] WARN if icp_quality below this
6:     input_error_sec: 5.0  # [s]   ERROR if no observation for this long
6:     input_stale_sec: 3.0  # [s]   STALE if no observation for this long
6:     timing_utilization_warn: 0.80  # [0-1] WARN if avg process time / sensor period exceeds
6:   # Save the final trajectory in TUM format. Disabled by default.
6:   estimated_trajectory:
6:     output_file: estimated_trajectory.tum
6:     save_to_file: false
6:   # These sensor labels will be handled as GNSS (GPS) (For storage in simplemap only)
6:   gnss_sensor_label: gps
6:   # Profile the internal steps of the ICP implementation:
6:   icp_profiler_enabled: false
6:   # IMU accelerometer-based verticality correction:
6:   # Uses averaged accelerometer readings to constrain ICP pitch/roll.
6:   imu_gravity_correction:
6:     adaptive_sigma: true
6:     averaging_samples: 20
6:     enabled: true
6:     # NOTE: averaging_samples must fit inside max_age_seconds at the actual IMU
6:     # rate, or estimatedPitchRoll() returns nothing and the constraint is
6:     # silently inactive (at 400 Hz, 2.0 s holds only ~800 samples).
6:     # 
6:     # Estimate the map-frame vertical online instead of freezing it from one
6:     # accelerometer average at the first keyframe. See
6:     # mola::imu::MapGravityEstimator: it solves for gravity in the map frame
6:     # (plus IMU biases) from preintegrated IMU and this odometry's own relative
6:     # attitudes/velocities, so platform acceleration cancels and no
6:     # quasi-static window is required.
6:     map_gravity:
6:       enabled: false
6:       # Compute and log the estimate without letting it affect the verticality
6:       # reference, so it can be scored against ground truth on a new dataset
6:       # without its own feedback contaminating the map frame it is estimating.
6:       log_only: false
6:       min_interval_seconds: 1.0
6:       # NOTE: there is deliberately no ACCURACY threshold here. The estimator
6:       # reports every usable estimate with its earned pitch/roll sigma, which is
6:       # added in quadrature to the gravity prior's sigma.
6:       # 
6:       # CAUTION: "a weak estimate silences itself" is NOT established. A later
6:       # measurement on a handheld dataset put the error/sigma ratio at 8.4
6:       # median and 19.0 worst case, i.e. the reported sigma is roughly an order
6:       # of magnitude tighter than the estimate is accurate, and no better
6:       # calibrated after the interval gate below than before it. Do not use
6:       # those sigmas as a confidence gate until that is understood; the
6:       # re-level trigger above deliberately does not.
6:       # 
6:       # There IS a data-quantity precondition, which is a different thing. Until
6:       # the window holds enough intervals the solution is pulled by the |g|
6:       # constraint and the bias priors, and that pull is a BIAS the linearized
6:       # covariance cannot see, so the estimate is not merely uncertain, it is
6:       # confidently wrong. Until then the accelerometer capture is the better
6:       # reference, and this keeps LO on it. This gates the PER-SCAN PRIOR only:
6:       # the one-off map-frame re-level above has the opposite need (its estimate
6:       # is best at the first solve) and uses its own, much shorter, gate.
6:       min_intervals_for_convergence: 130
6:       # Rotate the MAP FRAME itself, once, so it becomes gravity-aligned,
6:       # instead of only feeding the per-scan verticality prior. The map frame is
6:       # the initial body frame, so a platform that starts tilted produces a map
6:       # that leans by that tilt forever: measured on a handheld dataset, a
6:       # median of 8.7 deg (max 20.7). This is a gauge change - local map,
6:       # simplemap, trajectory, state estimator and the published `odom` frame
6:       # all rotate together about the map origin - so no relative quantity
6:       # moves. OFF by default: it changes the frame every product of the run is
6:       # expressed in.
6:       relevel_map_frame: false
6:       # Readiness for the re-level, as an interval count. Note this is NOT
6:       # min_intervals_for_convergence below: that one gates the per-scan prior,
6:       # where the later, more settled estimate is what matters. For leveling the
6:       # map once, the estimate is at its BEST at the first solve (measured 0.72
6:       # deg at ~5.6 s) and slowly degrades from there, so waiting costs accuracy.
6:       # 5 intervals is the first solve under solve_every_n above.
6:       relevel_min_intervals: 5
6:       # Magnitude gate: only re-level when there is enough tilt that removing it
6:       # beats the error of the estimate doing the removing. Measured at the
6:       # firing point on a handheld dataset, that error is 0.63 deg median,
6:       # 1.43 deg p90, 1.75 deg worst. Note the gate tests the ESTIMATE while the
6:       # quantity that must be large is the TRUE tilt, and the two differ by
6:       # exactly that error, so the threshold is ~2x the p90 rather than 1x:
6:       # gating at 2 deg let one near-level sequence through (estimate 2.8 deg
6:       # against a true 1.1 deg) and made it 0.7 deg worse. Below the threshold
6:       # the re-level stands down permanently (and says so in the log) instead of
6:       # retrying, which is what keeps an already-level dataset untouched.
6:       relevel_min_tilt_deg: 3.0
6:       solve_every_n: 5
6:       # Sliding-window length. The whole point is that verticality information
6:       # ACCUMULATES, so this wants to be much longer than the estimator default.
6:       window_size: 200
6:     map_origin_capture_timeout: 3.0
6:     # The one-shot map-origin verticality capture defines the map's vertical
6:     # for the whole run, so it is deferred to a later scan while the buffered
6:     # accelerometer directions disagree by more than this (i.e. the reading is
6:     # motion, not gravity), and taken as-is after the timeout.
6:     map_origin_max_dispersion_deg: 1.0
6:     max_age_seconds: 2.0
6:     sigma_deg: 2.0
6:     # Yaw-free, rank-2 verticality constraint solved by mp2p_icp. Set to false
6:     # only to reproduce results from the legacy path, which folded tilt into
6:     # the SE(3) pose prior.
6:     use_rank2_prior: true
6:   # These sensor labels will be handled as IMU observations:
6:   imu_sensor_label: imu
6:   # These sensor labels will be handled as LIDAR observations:
6:   # Can be overridden with cli flag --lidar-sensor-label
6:   lidar_sensor_labels:
6:     - lidar
6:     - /ouster/points
6:   # How often to update the local map model:
6:   local_map_updates:
6:     check_for_removal_every_n: 100
6:     enabled: true
6:     load_existing_local_map: ''
6:     load_map_after_gui_init: false
6:     # Should match the "remove farther than" option of the local metric map. "0" means deletion of distant key-frames is disabled
6:     max_distance_to_keep_keyframes: max(100.0, 1.50*ESTIMATED_OBSERVATION_RADIUS)  # [m]
6:     min_nearby_poses_occupied: 1
6:     min_rotation_between_keyframes: (15 + sqrt(wx^2+wy^2+wz^2)*5 )  # [deg]
6:     # Idea: don't integrate scans with a high rotational speed since they are probably not correctly deskewed:
6:     min_translation_between_keyframes: (0.1e-2 + sqrt(wx^2+wy^2+wz^2)*0.1)*ESTIMATED_OBSERVATION_RADIUS  # [m]
6:     publish_map_updates_every_n: 40
6:     save_final_local_map: ''  # If not empty, saves the final local metric map to a ".mm" file
6:   # Minimum ICP quality to insert it into the map:
6:   min_icp_goodness: 0.50
6:   # [m^-2] Minimum motion model covariance (in X,Y,Z) to consider a state estimation as valid as prior for ICP.
6:   min_motion_model_xyz_cov_inv: 1.0
6:   # Optionally, drop lidar data too close in time:
6:   min_time_between_scans: 1e-3  # [seconds]
6:   multiple_lidars:
6:     lidar_count: 1  # useful only if using several lidar_sensor_labels or regex's.
6:     max_time_offset: 0.1  # [s]
6:   # Parameters for max sensor range automatic estimation:
6:   observation_radius_filter_coefficient: 0.95
6:   # Quantile of the per-point norms taken as ESTIMATED_OBSERVATION_RADIUS.
6:   # 1.0 = the bounding-box max-norm, i.e. one far return sets the scene
6:   # scale for the six parameters derived from it. Default unchanged;
6:   # exposed so the robust alternative can be measured.
6:   observation_radius_quantile: 1.0
6:   # Optional filters to discard incomplete 3D scans from
6:   # faulty network, missing UDP packets, etc.
6:   observation_validity_checks:
6:     check_layer_name: raw
6:     enabled: false
6:     minimum_point_count: 1000
6:   # If enabled, vehicle twist will be optimized during ICP
6:   # enabling better and more robust odometry in high dynamics motion without an IMU.
6:   # NOTE: Disabled for more efficient deskew in the GICP pipeline with IMU.
6:   # Enabling it costs about 25% more time per scan. On KITTI, which has no IMU
6:   # and so no other source of velocity, it still bought nothing measurable, so
6:   # do not assume it helps just because a platform lacks an IMU: measure it.
6:   optimize_twist: false
6:   pipeline_name: GICP (Generalized ICP) with cov-to-cov pairings  # For display/debug only
6:   # Profile the main steps of the odometry pipeline:
6:   pipeline_profiler_enabled: false
6:   # If enabled, deskewed scans will be published (so, they will be available as ROS2 messages), mostly for visualization.
6:   # This may slow-down the system, so it is disabled by default.
6:   publish_deskewed_scans: false
6:   # When publishing pose updates, the reference frame for both, estimated robot poses, and the local map.
6:   publish_reference_frame: odom
6:   # When publishing pose updates, the vehicle frame name.
6:   publish_vehicle_frame: base_link
6:   # If enabled, a map will be stored in RAM and (if using the CLI) stored
6:   # to a ".simplemap" file for later use for localization, etc.
6:   simplemap:
6:     add_non_keyframes_too: false  # If enabled, all frames are stored in the simplemap, but non-keyframes will be without associated observations.
6:     generate: false  # Can be overridden with CLI flag --output-simplemap
6:     generate_lazy_load_scan_files: false  # If enabled, a directory will be create alongside the .simplemap and pointclouds will be externally serialized there.
6:     load_existing_simple_map: ''
6:     min_nearby_poses_occupied: 1
6:     min_rotation_between_keyframes: (15 + sqrt(wx^2+wy^2+wz^2)*5 )  # [deg]
6:     # NOTE: unlike local_map_updates above, these thresholds are NOT scaled by
6:     # angular velocity: this is what feeds the SharedKeyframeMap sink (e.g.
6:     # mola_mapper), and the old w-scaled formula (rotation threshold growing
6:     # by 500 deg per rad/s) made it create close to NO keyframes while
6:     # smoothly turning, starving loop closure of the keyframes it needs.
6:     min_translation_between_keyframes: (1.0e-2 + sqrt(wx^2+wy^2+wz^2)*0.1)*ESTIMATED_OBSERVATION_RADIUS  # [m]
6:     # Revisiting an already-mapped area creates NO keyframes with the purely
6:     # spatial criterion above, which starves loop closure of the second endpoint
6:     # of the loop. Set to a positive value [s] so only keyframes newer than that
6:     # take part in the "is there one here already?" test.
6:     nearby_keyframe_time_window: 0  # [s], 0=disabled
6:     # If enabled, this will store deskewed scans into the keyframes of simplemaps.
6:     save_deskewed_scans: false
6:     save_final_map_to_file: final_map.simplemap
6:     save_gnss_max_age: 1.0  # [s] max age of GNSS observations to keep in the keyframe
6:   # If set to false, the odometry pipeline will ignore incoming observations
6:   # until active is set to true (e.g. via the GUI).
6:   start_active: true
6:   # If run within a mola-cli container, and mola_viz is present, use these options
6:   # to show live progress:
6:   visualization:
6:     background_color_gray_level: 0.3
6:     # Camera tracks the vehicle. Exposed as an env hook so an integrator (e.g.
6:     # mola_mapper, where the mapper module owns the camera) can disable it here
6:     # without editing this pipeline. Default true (standalone LIO behavior).
6:     camera_follows_vehicle: true
6:     current_observation_alpha: 0.20
6:     current_observation_color_by_field: intensity
6:     current_observation_colormap: cmHOT  # mrpt::img::TColormap
6:     current_observation_point_size: 2.0
6:     ground_grid_spacing: 5.0  # [m]
6:     last_deskewed_observations_color_by_field: intensity
6:     last_deskewed_observations_colormap: cmJET  # mrpt::img::TColormap
6:     last_deskewed_observations_point_size: 1.0
6:     local_map_point_size: 1
6:     map_update_decimation: 10
6:     model:
6:       -
6:         file: ''  # Default: none
6:         tf.pitch: 0.0  # deg
6:         tf.roll: 90.0  # deg
6:         tf.x: 0.0  # deg
6:         tf.y: 0.0  # deg
6:         tf.yaw: 0.0  # deg
6:         tf.z: 0.0  # deg
6:     observations_decay_seconds: 10.0  # For deskewed clouds above
6:     observations_initial_alpha: 0.10
6:     show_current_observation: false  # shows "live deskewed" LiDAR points
6:     # current_pose_corner_size: 1.5
6:     # sensor_poses_corner_size: 0.5  # XYZ corner for each LiDAR sensor pose; 0 to disable
6:     show_current_pose_corner: true  # Set to false to hide the current-pose XYZ corner (e.g. for a first-person camera)
6:     show_gravity_align_vector: false
6:     show_ground_grid: true
6:     show_last_deskewed_observations_decay: true  # shows "live deskewed" LiDAR points over time
6:     show_localmap: true
6:     show_tab_control: true
6:     # Enable or disable each of the three GUI panels:
6:     show_tab_status: true
6:     show_tab_view: true
6:     # Robot /tf tree (e.g. a legged robot's joints). Requires the data source
6:     # to implement mola::TransformTreeSource (rosbag1/rosbag2 inputs and the
6:     # ROS 2 bridge do). All of these can also be toggled at runtime, in the
6:     # GUI's "View" tab.
6:     show_tf_tree: false
6:     show_trajectory: true
6:     tf_tree_corner_size: 0.1  # [m]
6:     tf_tree_exclude_frames: ''  # comma-separated; drops each frame and its subtree
6:     tf_tree_link_radius: 0.02  # [m], cylinder radius for tf links
6:     tf_tree_root_frame: ''  # empty: use the data source's base_link frame
6:     tf_tree_show_links: true
6:     tf_tree_show_names: false
6:     trajectory_rgba:
6:       - 0.1
6:       - 0.1
6:       - 0.1
6:       - 1.0
6:   # If defined, ".icplog" files will be saved if ICP quality drops below the given threshold.
6:   # Useful to debug mapping issues. If empty, only the env var MP2P_ICP_GENERATE_DEBUG_FILES and the icp.params setting will define when to save logs.
6:   write_debug_icp_log_if_quality_under: ''
6: 
6: [01:28:44.4777|DEBUG|LidarOdometry] Loading these params:
6: absolute_minimum_observation_radius: 5.0
6: # Adaptive threshold:
6: adaptive_threshold:
6:   alpha: 0.90
6:   enabled: true
6:   icp_quality_controller_setpoint: 0.85
6:   initial_sigma: 0.50  # [m]
6:   kp: 2.0
6:   max_sigma_step: 0.05  # [m]
6:   maximum_sigma: 2.00  # [m]
6:   min_motion: 0.5  # [m]
6:   recover_after_n_bad: 2
6:   recover_growth_factor: 2.0
6:   # Sustained-failure recovery: if enabled, sigma is grown multiplicatively
6:   # after a streak of bad ICPs, capped at maximum_sigma, so the matcher
6:   # window can re-open and ICP can recover. Enabled by default: without it,
6:   # once sigma is driven down near min_motion by a run of easy/near-static
6:   # scans (e.g. goodness consistently above icp_quality_controller_setpoint),
6:   # a single larger inter-scan motion (a turn, a bump, or just ordinary
6:   # scan-to-scan variability once sigma is already pinned at its floor) can
6:   # push ICP into failure, and with sigma frozen the correspondence search
6:   # window never reopens, so the pipeline stalls indefinitely
6:   # (estimated_trajectory never grows again). Set to false to restore the
6:   # old behavior. `maximum_sigma` must be set strictly above
6:   # `initial_sigma`, or this mechanism is a no-op: sigma always starts
6:   # each run AT initial_sigma, so a bad ICP on frame 1 (e.g. a slightly
6:   # imprecise localization-only seed pose against a prebuilt map) has no
6:   # room to grow into and can never recover (observed in testing as ICP
6:   # goodness stuck just under min_icp_goodness for an entire run).
6:   # 
6:   # recover_after_n_bad/recover_growth_factor default to a fast reaction
6:   # (2 bad frames, x2.0 growth) rather than a slow one (5 bad frames,
6:   # x1.5): every frame spent stuck is a frame of real, untracked vehicle
6:   # motion accumulating; the slower defaults let that gap grow to the
6:   # point where, once the search window finally reopens, ICP can lock onto
6:   # a self-consistent but WRONG registration (observed in testing as a
6:   # sudden ~30-40 deg yaw error that then persisted for the rest of a run)
6:   # instead of recovering the true pose.
6:   recover_on_sustained_failure: true
6: # Generate CSV with the evolution of internal variables:
6: debug_traces:
6:   output_file: mola-lo-traces.csv
6:   save_to_file: false
6: # REP-107 diagnostics thresholds published on /diagnostics via mola_bridge_ros2.
6: # Any of these can be omitted to keep its built-in default.
6: diagnostics:
6:   dropped_ratio_error: 0.50  # [0-1] ERROR if dropped-frames ratio exceeds
6:   dropped_ratio_warn: 0.20  # [0-1] WARN if dropped-frames ratio exceeds
6:   icp_quality_error: 0.10  # [0-1] ERROR if icp_quality below this
6:   icp_quality_warn: 0.30  # [0-1] WARN if icp_quality below this
6:   input_error_sec: 5.0  # [s]   ERROR if no observation for this long
6:   input_stale_sec: 3.0  # [s]   STALE if no observation for this long
6:   timing_utilization_warn: 0.80  # [0-1] WARN if avg process time / sensor period exceeds
6: # Save the final trajectory in TUM format. Disabled by default.
6: estimated_trajectory:
6:   output_file: estimated_trajectory.tum
6:   save_to_file: false
6: # These sensor labels will be handled as GNSS (GPS) (For storage in simplemap only)
6: gnss_sensor_label: gps
6: # Profile the internal steps of the ICP implementation:
6: icp_profiler_enabled: false
6: # IMU accelerometer-based verticality correction:
6: # Uses averaged accelerometer readings to constrain ICP pitch/roll.
6: imu_gravity_correction:
6:   adaptive_sigma: true
6:   averaging_samples: 20
6:   enabled: true
6:   # NOTE: averaging_samples must fit inside max_age_seconds at the actual IMU
6:   # rate, or estimatedPitchRoll() returns nothing and the constraint is
6:   # silently inactive (at 400 Hz, 2.0 s holds only ~800 samples).
6:   # 
6:   # Estimate the map-frame vertical online instead of freezing it from one
6:   # accelerometer average at the first keyframe. See
6:   # mola::imu::MapGravityEstimator: it solves for gravity in the map frame
6:   # (plus IMU biases) from preintegrated IMU and this odometry's own relative
6:   # attitudes/velocities, so platform acceleration cancels and no
6:   # quasi-static window is required.
6:   map_gravity:
6:     enabled: false
6:     # Compute and log the estimate without letting it affect the verticality
6:     # reference, so it can be scored against ground truth on a new dataset
6:     # without its own feedback contaminating the map frame it is estimating.
6:     log_only: false
6:     min_interval_seconds: 1.0
6:     # NOTE: there is deliberately no ACCURACY threshold here. The estimator
6:     # reports every usable estimate with its earned pitch/roll sigma, which is
6:     # added in quadrature to the gravity prior's sigma.
6:     # 
6:     # CAUTION: "a weak estimate silences itself" is NOT established. A later
6:     # measurement on a handheld dataset put the error/sigma ratio at 8.4
6:     # median and 19.0 worst case, i.e. the reported sigma is roughly an order
6:     # of magnitude tighter than the estimate is accurate, and no better
6:     # calibrated after the interval gate below than before it. Do not use
6:     # those sigmas as a confidence gate until that is understood; the
6:     # re-level trigger above deliberately does not.
6:     # 
6:     # There IS a data-quantity precondition, which is a different thing. Until
6:     # the window holds enough intervals the solution is pulled by the |g|
6:     # constraint and the bias priors, and that pull is a BIAS the linearized
6:     # covariance cannot see, so the estimate is not merely uncertain, it is
6:     # confidently wrong. Until then the accelerometer capture is the better
6:     # reference, and this keeps LO on it. This gates the PER-SCAN PRIOR only:
6:     # the one-off map-frame re-level above has the opposite need (its estimate
6:     # is best at the first solve) and uses its own, much shorter, gate.
6:     min_intervals_for_convergence: 130
6:     # Rotate the MAP FRAME itself, once, so it becomes gravity-aligned,
6:     # instead of only feeding the per-scan verticality prior. The map frame is
6:     # the initial body frame, so a platform that starts tilted produces a map
6:     # that leans by that tilt forever: measured on a handheld dataset, a
6:     # median of 8.7 deg (max 20.7). This is a gauge change - local map,
6:     # simplemap, trajectory, state estimator and the published `odom` frame
6:     # all rotate together about the map origin - so no relative quantity
6:     # moves. OFF by default: it changes the frame every product of the run is
6:     # expressed in.
6:     relevel_map_frame: false
6:     # Readiness for the re-level, as an interval count. Note this is NOT
6:     # min_intervals_for_convergence below: that one gates the per-scan prior,
6:     # where the later, more settled estimate is what matters. For leveling the
6:     # map once, the estimate is at its BEST at the first solve (measured 0.72
6:     # deg at ~5.6 s) and slowly degrades from there, so waiting costs accuracy.
6:     # 5 intervals is the first solve under solve_every_n above.
6:     relevel_min_intervals: 5
6:     # Magnitude gate: only re-level when there is enough tilt that removing it
6:     # beats the error of the estimate doing the removing. Measured at the
6:     # firing point on a handheld dataset, that error is 0.63 deg median,
6:     # 1.43 deg p90, 1.75 deg worst. Note the gate tests the ESTIMATE while the
6:     # quantity that must be large is the TRUE tilt, and the two differ by
6:     # exactly that error, so the threshold is ~2x the p90 rather than 1x:
6:     # gating at 2 deg let one near-level sequence through (estimate 2.8 deg
6:     # against a true 1.1 deg) and made it 0.7 deg worse. Below the threshold
6:     # the re-level stands down permanently (and says so in the log) instead of
6:     # retrying, which is what keeps an already-level dataset untouched.
6:     relevel_min_tilt_deg: 3.0
6:     solve_every_n: 5
6:     # Sliding-window length. The whole point is that verticality information
6:     # ACCUMULATES, so this wants to be much longer than the estimator default.
6:     window_size: 200
6:   map_origin_capture_timeout: 3.0
6:   # The one-shot map-origin verticality capture defines the map's vertical
6:   # for the whole run, so it is deferred to a later scan while the buffered
6:   # accelerometer directions disagree by more than this (i.e. the reading is
6:   # motion, not gravity), and taken as-is after the timeout.
6:   map_origin_max_dispersion_deg: 1.0
6:   max_age_seconds: 2.0
6:   sigma_deg: 2.0
6:   # Yaw-free, rank-2 verticality constraint solved by mp2p_icp. Set to false
6:   # only to reproduce results from the legacy path, which folded tilt into
6:   # the SE(3) pose prior.
6:   use_rank2_prior: true
6: # These sensor labels will be handled as IMU observations:
6: imu_sensor_label: imu
6: # These sensor labels will be handled as LIDAR observations:
6: # Can be overridden with cli flag --lidar-sensor-label
6: lidar_sensor_labels:
6:   - lidar
6:   - /ouster/points
6: # How often to update the local map model:
6: local_map_updates:
6:   check_for_removal_every_n: 100
6:   enabled: true
6:   load_existing_local_map: ''
6:   load_map_after_gui_init: false
6:   # Should match the "remove farther than" option of the local metric map. "0" means deletion of distant key-frames is disabled
6:   max_distance_to_keep_keyframes: max(100.0, 1.50*ESTIMATED_OBSERVATION_RADIUS)  # [m]
6:   min_nearby_poses_occupied: 1
6:   min_rotation_between_keyframes: (15 + sqrt(wx^2+wy^2+wz^2)*5 )  # [deg]
6:   # Idea: don't integrate scans with a high rotational speed since they are probably not correctly deskewed:
6:   min_translation_between_keyframes: (0.1e-2 + sqrt(wx^2+wy^2+wz^2)*0.1)*ESTIMATED_OBSERVATION_RADIUS  # [m]
6:   publish_map_updates_every_n: 40
6:   save_final_local_map: ''  # If not empty, saves the final local metric map to a ".mm" file
6: # Minimum ICP quality to insert it into the map:
6: min_icp_goodness: 0.50
6: # [m^-2] Minimum motion model covariance (in X,Y,Z) to consider a state estimation as valid as prior for ICP.
6: min_motion_model_xyz_cov_inv: 1.0
6: # Optionally, drop lidar data too close in time:
6: min_time_between_scans: 1e-3  # [seconds]
6: multiple_lidars:
6:   lidar_count: 1  # useful only if using several lidar_sensor_labels or regex's.
6:   max_time_offset: 0.1  # [s]
6: # Parameters for max sensor range automatic estimation:
6: observation_radius_filter_coefficient: 0.95
6: # Quantile of the per-point norms taken as ESTIMATED_OBSERVATION_RADIUS.
6: # 1.0 = the bounding-box max-norm, i.e. one far return sets the scene
6: # scale for the six parameters derived from it. Default unchanged;
6: # exposed so the robust alternative can be measured.
6: observation_radius_quantile: 1.0
6: # Optional filters to discard incomplete 3D scans from
6: # faulty network, missing UDP packets, etc.
6: observation_validity_checks:
6:   check_layer_name: raw
6:   enabled: false
6:   minimum_point_count: 1000
6: # If enabled, vehicle twist will be optimized during ICP
6: # enabling better and more robust odometry in high dynamics motion without an IMU.
6: # NOTE: Disabled for more efficient deskew in the GICP pipeline with IMU.
6: # Enabling it costs about 25% more time per scan. On KITTI, which has no IMU
6: # and so no other source of velocity, it still bought nothing measurable, so
6: # do not assume it helps just because a platform lacks an IMU: measure it.
6: optimize_twist: false
6: pipeline_name: GICP (Generalized ICP) with cov-to-cov pairings  # For display/debug only
6: # Profile the main steps of the odometry pipeline:
6: pipeline_profiler_enabled: false
6: # If enabled, deskewed scans will be published (so, they will be available as ROS2 messages), mostly for visualization.
6: # This may slow-down the system, so it is disabled by default.
6: publish_deskewed_scans: false
6: # When publishing pose updates, the reference frame for both, estimated robot poses, and the local map.
6: publish_reference_frame: odom
6: # When publishing pose updates, the vehicle frame name.
6: publish_vehicle_frame: base_link
6: # If enabled, a map will be stored in RAM and (if using the CLI) stored
6: # to a ".simplemap" file for later use for localization, etc.
6: simplemap:
6:   add_non_keyframes_too: false  # If enabled, all frames are stored in the simplemap, but non-keyframes will be without associated observations.
6:   generate: false  # Can be overridden with CLI flag --output-simplemap
6:   generate_lazy_load_scan_files: false  # If enabled, a directory will be create alongside the .simplemap and pointclouds will be externally serialized there.
6:   load_existing_simple_map: ''
6:   min_nearby_poses_occupied: 1
6:   min_rotation_between_keyframes: (15 + sqrt(wx^2+wy^2+wz^2)*5 )  # [deg]
6:   # NOTE: unlike local_map_updates above, these thresholds are NOT scaled by
6:   # angular velocity: this is what feeds the SharedKeyframeMap sink (e.g.
6:   # mola_mapper), and the old w-scaled formula (rotation threshold growing
6:   # by 500 deg per rad/s) made it create close to NO keyframes while
6:   # smoothly turning, starving loop closure of the keyframes it needs.
6:   min_translation_between_keyframes: (1.0e-2 + sqrt(wx^2+wy^2+wz^2)*0.1)*ESTIMATED_OBSERVATION_RADIUS  # [m]
6:   # Revisiting an already-mapped area creates NO keyframes with the purely
6:   # spatial criterion above, which starves loop closure of the second endpoint
6:   # of the loop. Set to a positive value [s] so only keyframes newer than that
6:   # take part in the "is there one here already?" test.
6:   nearby_keyframe_time_window: 0  # [s], 0=disabled
6:   # If enabled, this will store deskewed scans into the keyframes of simplemaps.
6:   save_deskewed_scans: false
6:   save_final_map_to_file: final_map.simplemap
6:   save_gnss_max_age: 1.0  # [s] max age of GNSS observations to keep in the keyframe
6: # If set to false, the odometry pipeline will ignore incoming observations
6: # until active is set to true (e.g. via the GUI).
6: start_active: true
6: # If run within a mola-cli container, and mola_viz is present, use these options
6: # to show live progress:
6: visualization:
6:   background_color_gray_level: 0.3
6:   # Camera tracks the vehicle. Exposed as an env hook so an integrator (e.g.
6:   # mola_mapper, where the mapper module owns the camera) can disable it here
6:   # without editing this pipeline. Default true (standalone LIO behavior).
6:   camera_follows_vehicle: true
6:   current_observation_alpha: 0.20
6:   current_observation_color_by_field: intensity
6:   current_observation_colormap: cmHOT  # mrpt::img::TColormap
6:   current_observation_point_size: 2.0
6:   ground_grid_spacing: 5.0  # [m]
6:   last_deskewed_observations_color_by_field: intensity
6:   last_deskewed_observations_colormap: cmJET  # mrpt::img::TColormap
6:   last_deskewed_observations_point_size: 1.0
6:   local_map_point_size: 1
6:   map_update_decimation: 10
6:   model:
6:     -
6:       file: ''  # Default: none
6:       tf.pitch: 0.0  # deg
6:       tf.roll: 90.0  # deg
6:       tf.x: 0.0  # deg
6:       tf.y: 0.0  # deg
6:       tf.yaw: 0.0  # deg
6:       tf.z: 0.0  # deg
6:   observations_decay_seconds: 10.0  # For deskewed clouds above
6:   observations_initial_alpha: 0.10
6:   show_current_observation: false  # shows "live deskewed" LiDAR points
6:   # current_pose_corner_size: 1.5
6:   # sensor_poses_corner_size: 0.5  # XYZ corner for each LiDAR sensor pose; 0 to disable
6:   show_current_pose_corner: true  # Set to false to hide the current-pose XYZ corner (e.g. for a first-person camera)
6:   show_gravity_align_vector: false
6:   show_ground_grid: true
6:   show_last_deskewed_observations_decay: true  # shows "live deskewed" LiDAR points over time
6:   show_localmap: true
6:   show_tab_control: true
6:   # Enable or disable each of the three GUI panels:
6:   show_tab_status: true
6:   show_tab_view: true
6:   # Robot /tf tree (e.g. a legged robot's joints). Requires the data source
6:   # to implement mola::TransformTreeSource (rosbag1/rosbag2 inputs and the
6:   # ROS 2 bridge do). All of these can also be toggled at runtime, in the
6:   # GUI's "View" tab.
6:   show_tf_tree: false
6:   show_trajectory: true
6:   tf_tree_corner_size: 0.1  # [m]
6:   tf_tree_exclude_frames: ''  # comma-separated; drops each frame and its subtree
6:   tf_tree_link_radius: 0.02  # [m], cylinder radius for tf links
6:   tf_tree_root_frame: ''  # empty: use the data source's base_link frame
6:   tf_tree_show_links: true
6:   tf_tree_show_names: false
6:   trajectory_rgba:
6:     - 0.1
6:     - 0.1
6:     - 0.1
6:     - 1.0
6: # If defined, ".icplog" files will be saved if ICP quality drops below the given threshold.
6: # Useful to debug mapping issues. If empty, only the env var MP2P_ICP_GENERATE_DEBUG_FILES and the icp.params setting will define when to save logs.
6: write_debug_icp_log_if_quality_under: ''
