7: localmap_generator:
7:   -
7:     class_name: mp2p_icp_filters::Generator
7:     params:
7:       metric_map_definition:
7:         class: mola::KeyframePointCloudMap
7:         creationOpts:
7:           alpha_balance: 0.75
7:           alpha_deleted: 0.5
7:           # If true, cov-to-cov ICP matching (Matcher_Cov2Cov) queries each active
7:           # keyframe's own cached KD-tree + covariances directly, instead of building
7:           # a merged submap from the active KF set. Faster (skips the merge/KD-tree
7:           # rebuild) at the cost of a slightly less accurate covariance estimate
7:           # (computed only from neighbors within the same source keyframe).
7:           approximate_cov: false
7:           # Run the k-d tree balancing rebuilds on a background thread, so the
7:           # mapping thread never pays for them. Measured on Oxford Spires, this
7:           # takes local-map insertion from mean 28 ms / max 371 ms (with 9 calls
7:           # over 200 ms) down to mean 10 ms / max 38 ms and no spike at all:
7:           async_rebuild: true
