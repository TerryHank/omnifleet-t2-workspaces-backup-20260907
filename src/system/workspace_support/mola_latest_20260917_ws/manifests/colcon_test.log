6: # Local map updates:
6: # Very first observation: Use the mp2p_icp pipeline generator to create the local map:
6: localmap_generator:
6:   -
6:     class_name: mp2p_icp_filters::Generator
6:     params:
6:       metric_map_definition:
6:         class: mola::KeyframePointCloudMap
6:         creationOpts:
6:           alpha_balance: 0.75
6:           alpha_deleted: 0.5
6:           # If true, cov-to-cov ICP matching (Matcher_Cov2Cov) queries each active
6:           # keyframe's own cached KD-tree + covariances directly, instead of building
6:           # a merged submap from the active KF set. Faster (skips the merge/KD-tree
6:           # rebuild) at the cost of a slightly less accurate covariance estimate
6:           # (computed only from neighbors within the same source keyframe).
6:           approximate_cov: false
6:           # Run the k-d tree balancing rebuilds on a background thread, so the
6:           # mapping thread never pays for them. Measured on Oxford Spires, this
6:           # takes local-map insertion from mean 28 ms / max 371 ms (with 9 calls
6:           # over 200 ms) down to mean 10 ms / max 38 ms and no spike at all:
6:           async_rebuild: true
6:           k_correspondences_for_cov: 20
6:           max_distance_for_cov: 2.0
6:           # --- mola::KeyframePointCloudMap only ---
6:           max_search_keyframes: 3
6:           max_view_angle_deg: 120
6:           min_correspondences_for_cov: 5
6:           num_diverse_keyframes: 1  # Must be < max_search_keyframes
6:           # --- mola::IncrementalPointCloud only ---
6:           # Half side [m] of the cube of points kept around the robot on each
6:           # insertion (Chebyshev distance, as in HashedVoxelPointCloud's
6:           # remove_voxels_farther_than). Unlike the keyframe map, EVERY point
6:           # inside this cube is kept in a single tree, so this is
6:           # a much tighter budget than 'remove_frames_farther_than' below
6:           remove_points_farther_than: $f{max(100.0, 1.5*ESTIMATED_OBSERVATION_RADIUS)}  # [m]
6:           # Pre-allocated point storage. With async_rebuild this also keeps the
6:           # mapping thread from ever having to wait for the background worker,
