[Unit]
Description=OmniFleet MSC-V1 high-level robot coordination agent
Wants=network-online.target
Wants=omnifleet-local-navigation.service
After=network-online.target omnifleet-local-navigation.service

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/workspace/system/shared_map_msc
ExecStart=/bin/bash /home/iecme/workspace/system/shared_map_msc/deployment/run.sh msc_agent /etc/omnifleet_msc/agent.json
Restart=on-failure
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
