[Unit]
Description=OmniFleet MSC-V1 two-robot coordinator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/msc_v1_ws
ExecStart=/bin/bash /home/iecme/msc_v1_ws/deployment/run.sh msc_coordinator /etc/omnifleet_msc/coordinator.json
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
