[Unit]
Description=OmniFleet MSC-V1 robot agent and exclusive velocity output
Wants=network-online.target
After=network-online.target
Before=omnifleet-t2-chassis.service

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/msc_v1_ws
ExecStart=/bin/bash /home/iecme/msc_v1_ws/deployment/run.sh msc_agent /etc/omnifleet_msc/agent.json
Restart=on-failure
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
