{
  "mode": "peer",
  "listen": {
    "endpoints": [
      "tcp/192.168.3.113:7600"
    ]
  },
  "connect": {
    "endpoints": [
      "tcp/192.168.3.104:7600"
    ],
    "timeout_ms": 0,
    "exit_on_failure": false
  },
  "scouting": {
    "multicast": {
      "enabled": false
    },
    "gossip": {
      "enabled": true,
      "autoconnect": {
        "peer": []
      }
    }
  },
  "timestamping": {
    "enabled": true
  },
  "transport": {
    "shared_memory": {
      "enabled": false
    },
    "link": {
      "tx": {
        "queue": {
          "congestion_control": {
            "block": {
              "wait_before_close": 500000
            }
          }
        }
      }
    }
  }
}