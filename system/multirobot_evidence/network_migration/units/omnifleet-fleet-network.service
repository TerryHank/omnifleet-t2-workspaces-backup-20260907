[Unit]
Description=OmniFleet isolated fleet network gateway
After=network-online.target omnifleet-t2-zenoh-router.service
Wants=network-online.target
[Service]
User=iecme
WorkingDirectory=/home/iecme/omnifleet_fleet
ExecStart=/bin/bash -c 'source /home/iecme/omnifleet_fleet/env.bash && exec python3 /home/iecme/omnifleet_fleet/gateway_network.py'
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=8
[Install]
WantedBy=multi-user.target
