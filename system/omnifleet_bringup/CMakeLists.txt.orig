cmake_minimum_required(VERSION 3.8)
project(omnifleet_bringup)

if(NOT CMAKE_CXX_STANDARD)
  set(CMAKE_CXX_STANDARD 14)
endif()

find_package(ament_cmake REQUIRED)
find_package(ament_cmake_python REQUIRED)

ament_python_install_package(omnifleet_bringup)

install(DIRECTORY launch config DESTINATION share/${PROJECT_NAME})
install(PROGRAMS
  scripts/t2_driver
  scripts/robot_doctor
  DESTINATION lib/${PROJECT_NAME})
install(FILES README.md DESTINATION share/${PROJECT_NAME})

if(BUILD_TESTING)
  find_package(ament_cmake_pytest REQUIRED)
  ament_add_pytest_test(test_t2_sensor_contract test/test_t2_sensor_contract.py)
  ament_add_pytest_test(
    test_t2_production_contract
    test/test_t2_production_contract.py)
endif()

ament_package()
