<?xml version="1.0"?>
<package format="3">
  <name>omnifleet_msc</name><version>0.2.0</version>
  <description>MSC-V1 two-robot coordination and local control ownership.</description>
  <maintainer email="maintainer@example.com">OmniFleet</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
