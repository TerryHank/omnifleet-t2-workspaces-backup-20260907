{
  "configById": {
    "3D!fleet": {
      "cameraState": {
        "distance": 16,
        "perspective": false,
        "phi": 60,
        "target": [0, 0, 0],
        "targetOffset": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "thetaOffset": 0,
        "fovy": 45,
        "near": 0.1,
        "far": 5000
      },
      "followMode": "follow-pose",
      "fixedFrame": "world",
      "scene": {},
      "transforms": {
        "robot1/base_link": {"visible": true},
        "robot2/base_link": {"visible": true},
        "robot3/base_link": {"visible": true}
      },
      "topics": {
        "/tf": {"visible": true},
        "/tf_static": {"visible": true},
        "/robot1/odom": {"visible": true, "color": "#ff5050"},
        "/robot2/odom": {"visible": true, "color": "#50dc78"},
        "/robot3/odom": {"visible": true, "color": "#508cff"}
      },
      "layers": {
        "grid": {
          "visible": true,
          "drawBehind": true,
          "instanceId": "omnifleet-world-grid",
          "layerId": "foxglove.Grid",
          "size": 12,
          "divisions": 12,
          "lineWidth": 1,
          "color": "#54728c",
          "position": [0, 0, 0],
          "rotation": [0, 0, 0]
        }
      },
      "publish": {
        "type": "pose",
        "poseTopic": "/fleet/goal",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.5,
        "poseEstimateYDeviation": 0.5,
        "poseEstimateThetaDeviation": 0.26179939
      },
      "synchronize": false,
      "imageMode": {}
    },
    "RawMessages!status": {
      "defaultExpanded": true,
      "topicPath": "/fleet/status"
    },
    "RawMessages!events": {
      "defaultExpanded": true,
      "topicPath": "/fleet/events"
    },
    "Publish!goal": {
      "topicName": "/fleet/goal",
      "datatype": "geometry_msgs/msg/PoseStamped",
      "value": "{\"header\":{\"stamp\":{\"sec\":0,\"nanosec\":0},\"frame_id\":\"world\"},\"pose\":{\"position\":{\"x\":0.5,\"y\":0.0,\"z\":0.0},\"orientation\":{\"x\":0.0,\"y\":0.0,\"z\":0.0,\"w\":1.0}}}",
      "foxglovePanelTitle": "Publish fleet goal",
      "buttonText": "Publish /fleet/goal"
    },
    "Publish!robot1-route": {
      "topicName": "/robot1/waypoints",
      "datatype": "nav_msgs/msg/Path",
      "value": "{\"header\":{\"stamp\":{\"sec\":0,\"nanosec\":0},\"frame_id\":\"world\"},\"poses\":[{\"header\":{\"frame_id\":\"world\"},\"pose\":{\"position\":{\"x\":-0.5,\"y\":0.0,\"z\":0.0},\"orientation\":{\"x\":0.0,\"y\":0.0,\"z\":0.0,\"w\":1.0}}},{\"header\":{\"frame_id\":\"world\"},\"pose\":{\"position\":{\"x\":0.0,\"y\":0.0,\"z\":0.0},\"orientation\":{\"x\":0.0,\"y\":0.0,\"z\":0.0,\"w\":1.0}}},{\"header\":{\"frame_id\":\"world\"},\"pose\":{\"position\":{\"x\":0.5,\"y\":0.0,\"z\":0.0},\"orientation\":{\"x\":0.0,\"y\":0.0,\"z\":0.0,\"w\":1.0}}},{\"header\":{\"frame_id\":\"world\"},\"pose\":{\"position\":{\"x\":1.0,\"y\":0.0,\"z\":0.0},\"orientation\":{\"x\":0.0,\"y\":0.0,\"z\":0.0,\"w\":1.0}}},{\"header\":{\"frame_id\":\"world\"},\"pose\":{\"position\":{\"x\":1.5,\"y\":0.0,\"z\":0.0},\"orientation\":{\"x\":0.0,\"y\":0.0,\"z\":0.0,\"w\":1.0}}}]}",
      "foxglovePanelTitle": "Arbitrary waypoint route (edit poses[])",
      "buttonText": "Publish all poses"
    },
    "CallService!cancel-all": {
      "serviceName": "/fleet/cancel_all",
      "serviceType": "std_srvs/srv/Trigger",
      "requestPayload": "{}",
      "layout": "vertical",
      "timeoutSeconds": 10,
      "foxglovePanelTitle": "Cancel fleet tasks",
      "buttonText": "Cancel all"
    },
    "CallService!clear-queue": {
      "serviceName": "/fleet/clear_queue",
      "serviceType": "std_srvs/srv/Trigger",
      "requestPayload": "{}",
      "layout": "vertical",
      "timeoutSeconds": 10,
      "foxglovePanelTitle": "Clear pending tasks",
      "buttonText": "Clear queue"
    },
    "Plot!odometry": {
      "paths": [
        {"value": "/robot1/odom.pose.pose.position.x", "enabled": true, "color": "#ff5050"},
        {"value": "/robot2/odom.pose.pose.position.x", "enabled": true, "color": "#50dc78"},
        {"value": "/robot3/odom.pose.pose.position.x", "enabled": true, "color": "#508cff"}
      ],
      "showLegend": true,
      "legendDisplay": "floating",
      "isSynced": true
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {"speed": 1},
  "layout": {
    "direction": "row",
    "first": "3D!fleet",
    "second": {
      "direction": "column",
      "first": {
        "direction": "row",
        "first": "RawMessages!status",
        "second": "RawMessages!events",
        "splitPercentage": 50
      },
      "second": {
        "direction": "row",
        "first": {
          "direction": "column",
          "first": "Publish!goal",
          "second": "Publish!robot1-route",
          "splitPercentage": 50
        },
        "second": {
          "direction": "column",
          "first": "CallService!cancel-all",
          "second": {
            "direction": "column",
            "first": "CallService!clear-queue",
            "second": "Plot!odometry",
            "splitPercentage": 25
          },
          "splitPercentage": 25
        },
        "splitPercentage": 45
      },
      "splitPercentage": 35
    },
    "splitPercentage": 58
  }
