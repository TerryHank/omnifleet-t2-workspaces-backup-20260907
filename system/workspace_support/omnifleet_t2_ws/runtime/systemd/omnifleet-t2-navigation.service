[Unit]
Description=OmniFleet T2 Nav2 only (start MOLA first)
After=omnifleet-t2-chassis.service omnifleet-t2-description.service omnifleet-t2-airy.service
Requires=omnifleet-t2-chassis.service omnifleet-t2-description.service omnifleet-t2-airy.service

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/workspace/omnifleet_t2_ws
Environment=HOME=/home/iecme
Environment=ROS_HOME=/var/lib/omnifleet_t2/ros
EnvironmentFile=/etc/omnifleet_t2/robot.env
ExecStart=/bin/bash -lc 'source /opt/ros/$ROS_DISTRO/setup.bash && source $OMNIFLEET_T2_SENSOR_WS/install/setup.bash && source $OMNIFLEET_T2_WS/install/setup.bash && exec ros2 launch omnifleet_bringup production_nav2.launch.py'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
