[Unit]
Description=OmniFleet T2 semantic waypoints
After=omnifleet-t2-foxglove.service

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/workspace/omnifleet_t2_ws
Environment=HOME=/home/iecme
Environment=ROS_HOME=/var/lib/omnifleet_t2/ros
EnvironmentFile=/etc/omnifleet_t2/robot.env
ExecStart=/bin/bash -lc 'source /opt/ros/$ROS_DISTRO/setup.bash && source $OMNIFLEET_T2_WS/install/setup.bash && exec ros2 launch omnifleet_waypoint_ui waypoint_ui.launch.py'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
