<?xml version="1.0"?>
<robot name="omnifleet_t2">
  <material name="body_blue"><color rgba="0.08 0.22 0.42 1.0"/></material>
  <material name="track_dark"><color rgba="0.06 0.06 0.06 1.0"/></material>
  <material name="sensor_gray"><color rgba="0.35 0.38 0.42 1.0"/></material>
  <material name="camera_black"><color rgba="0.03 0.03 0.03 1.0"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.26 0.16 0.08"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.50 0.37 0.33"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.160" ixy="0" ixz="0" iyy="0.359" iyz="0" izz="0.387"/>
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.075" rpy="0 0 0"/>
  </joint>

  <link name="left_track_link">
    <visual><geometry><box size="0.28 0.035 0.065"/></geometry><material name="track_dark"/></visual>
    <collision><geometry><box size="0.50 0.04 0.08"/></geometry></collision>
  </link>
  <joint name="left_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_track_link"/>
    <origin xyz="0 0.165 -0.035" rpy="0 0 0"/>
  </joint>

  <link name="right_track_link">
    <visual><geometry><box size="0.28 0.035 0.065"/></geometry><material name="track_dark"/></visual>
    <collision><geometry><box size="0.50 0.04 0.08"/></geometry></collision>
  </link>
  <joint name="right_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_track_link"/>
    <origin xyz="0 -0.165 -0.035" rpy="0 0 0"/>
  </joint>

  <link name="sensor_mast_link">
    <visual>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.11"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast_link"/>
    <origin xyz="0.02 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="rslidar">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="rslidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rslidar"/>
    <origin xyz="-0.041 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.07 0.025 0.028"/></geometry>
      <material name="camera_black"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.105 0 0.105" rpy="0 0 0"/>
  </joint>
</robot>
